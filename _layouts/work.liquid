<article class="work-entry">
  <div class="work-meta"><span class="work-year">{{ entry.year }}</span><span class="work-venue {% if entry.abbr == 'Preprint' %}is-preprint{% endif %}">{{ entry.abbr }}</span></div>
  <div class="work-body">
    <p class="work-topic">{{ entry.topic }}</p>
    <h3><a href="{{ entry.url }}">{{ entry.title }} <span class="work-arrow" aria-hidden="true">↗</span></a></h3>
    <p class="work-authors">{% for author in entry.author_array %}{% assign surname = author.last | remove: '*' %}{% if surname == 'Feng' and author.first == 'Yuanjun' %}<strong>{{ author.first }} {{ author.last }}</strong>{% else %}{{ author.first }} {{ author.last }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
    <p class="work-summary">{{ entry.summary }}</p>
    <div class="work-links"><a href="{{ entry.url }}">Read paper <span aria-hidden="true">↗</span></a>{% if entry.scholar_url %}<a href="{{ entry.scholar_url | escape }}">Google Scholar <span aria-hidden="true">↗</span></a>{% endif %}</div>
  </div>
</article>
